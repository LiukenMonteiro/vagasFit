{
  "name": "vaga-fit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @vagafit/api\" \"npm run dev -w @vagafit/web\"",
    "build": "npm run build -w @vagafit/api && npm run build -w @vagafit/web",
    "start": "npm run start -w @vagafit/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
