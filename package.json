{
  "name": "vaga-fit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @vagafit/api\" \"npm run dev -w @vagafit/web\"",
    "build": "npm run build -w @vagafit/web",
    "db:up": "docker compose up -d",
    "db:init": "npm run db:init -w @vagafit/api",
    "test": "npm run test -w @vagafit/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
