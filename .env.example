API_PORT=3333
WEB_ORIGIN=http://localhost:5173

# Firebird (use os mesmos valores do docker-compose.yml)
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=/var/lib/firebird/data/vagafit.fdb
FIREBIRD_USER=vagafit
FIREBIRD_PASSWORD=vagafit
# Só se a libfbclient não estiver instalada no sistema:
# FIREBIRD_CLIENT_LIB=/caminho/para/libfbclient.so
